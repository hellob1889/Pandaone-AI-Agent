# ============================================================
# Pandaone AI Agent .gitignore
# ============================================================

# Python 构建产物
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# 测试
.pytest_cache/
.coverage
.tox/
htmlcov/

# 虚拟环境
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 工具
.mypy_cache/
.ruff_cache/

# Pandaone 自身产物
test_project/

# Pandaone 运行时状态目录（init 后生成）
.codeaudit/

# OS
.DS_Store
Thumbs.db

# 临时
*.tmp
*.bak

# Installer（保留 .iss 脚本，忽略 staging 目录）
installer/staging/
installer/Output/

# Release artifacts(用户级输出,不入仓库 — 重新打包请跑 scripts/release.py)
Pandaone-*-install.zip
Pandaone-*.exe
# 历史遗留的旧品牌名 install 包（PandaX 改名 Pandaone 之前的产物）
PandaX-*-install.zip
PandaX-*.exe

# ============================================================
# Workspace 临时产物（本次工作 session 产生，不入仓库）
# ============================================================
# 17 字节占位符文件
image.png
/index.html
# 大体积临时 HTML 报告
CodeAudit_项目文档.html

# ============================================================
# 独立 git 仓库（demo 自带 .git，不应被主仓库接管）
# ============================================================
examples/demo_03_bypass/
examples/demo_05_full/


# Pandaone 运行时产物(自动管理,不要手动提交)
.pandaone/
desktop.ini

# ============================================================
# Trae IDE 临时文件 + 大体积 workspace 产物（不入仓库）
# ============================================================
.trae/
.trae-html-share-packages/

# Smithery 提交草稿（付费平台，按"需要收费的不做"原则不入仓）
smithery_*.html
